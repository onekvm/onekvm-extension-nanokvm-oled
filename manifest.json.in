{
  "id": "nanokvm-oled",
  "i18n": {
    "default": {
      "name": "NanoKVM OLED",
      "description": "Designs and controls the NanoKVM OLED pixel canvas, viewing direction, sleep behavior, and burn-in protection."
    },
    "zh": {
      "name": "NanoKVM OLED",
      "description": "设计并控制 NanoKVM OLED 像素画布、观看方向、自动熄屏和防烧屏保护。"
    },
    "zh-TW": {
      "name": "NanoKVM OLED",
      "description": "設計並控制 NanoKVM OLED 像素畫布、觀看方向、自動熄屏和防燒屏保護。"
    }
  },
  "version": "@VERSION@",
  "api_version": 2,
  "architecture": "@ARCH@",
  "device_variants": ["pcie", "cube"],
  "default_enabled": true,
  "kind": "service",
  "author": "OneKVM",
  "homepage": "https://github.com/onekvm/onekvm-extension-nanokvm-oled",
  "entrypoint": "bin/onekvm-nanokvm-oled",
  "permissions": ["device-i2c"],
  "routes": [{"path":"assets","backend":"unix","socket":"assets.sock","auth":"session"}],
  "capabilities": [],
  "services": [{
    "id": "display",
    "i18n": {
      "default": {"name": "OLED display", "description": "NanoKVM OLED status display service."},
      "zh": {"name": "OLED 显示", "description": "NanoKVM OLED 状态显示服务。"},
      "zh-TW": {"name": "OLED 顯示", "description": "NanoKVM OLED 狀態顯示服務。"}
    }
  }, {
    "id": "assets",
    "i18n": {
      "default": {"name": "OLED animation assets", "description": "Remote OLED animation asset storage."},
      "zh": {"name": "OLED 动图素材", "description": "远程保存 OLED 动图素材。"},
      "zh-TW": {"name": "OLED 動圖素材", "description": "遠端儲存 OLED 動圖素材。"}
    }
  }],
  "page": {
    "title": "OLED",
    "renderer": "vue",
    "entrypoint": "web/oled-page.js",
    "icon": {"source": "lucide", "name": "monitor"}
  },
  "settings_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "display_enabled", "burn_in_protection", "rotation",
      "sleep_seconds", "layout_json"
    ],
    "properties": {
      "display_enabled": {"type": "boolean", "title": "Display", "default": true, "i18n": {"default": "Display", "zh": "OLED 显示", "zh-TW": "OLED 顯示"}},
      "burn_in_protection": {"type": "boolean", "title": "Burn-in protection", "default": true, "i18n": {"default": "Burn-in protection", "zh": "防烧屏保护", "zh-TW": "防燒屏保護"}},
      "rotation": {"type": "integer", "title": "Viewing direction", "default": 0, "minimum": 0, "maximum": 270, "i18n": {"default": "Viewing direction", "zh": "观看方向", "zh-TW": "觀看方向"}},
      "sleep_seconds": {"type": "integer", "title": "Automatic screen-off", "default": 3600, "minimum": 0, "maximum": 86400, "i18n": {"default": "Automatic screen-off", "zh": "自动熄屏", "zh-TW": "自動熄屏"}},
      "layout_json": {"type": "string", "title": "Canvas layout", "default": "", "maxLength": 4096, "i18n": {"default": "Canvas layout", "zh": "画布布局", "zh-TW": "畫布配置"}},
      "variables_json": {"type": "string", "title": "Custom variables", "default": "{}", "maxLength": 2048, "i18n": {"default": "Custom variables", "zh": "自定义变量", "zh-TW": "自訂變數"}},
      "brightness": {"type": "integer", "title": "Legacy brightness", "minimum": 1, "maximum": 100, "readOnly": true, "i18n": {"default": "Legacy brightness", "zh": "旧版亮度", "zh-TW": "舊版亮度"}},
      "line1": {"type": "string", "title": "Legacy line 1", "maxLength": 64, "readOnly": true, "i18n": {"default": "Legacy line 1", "zh": "旧版第 1 行", "zh-TW": "舊版第 1 行"}},
      "line2": {"type": "string", "title": "Legacy line 2", "maxLength": 64, "readOnly": true, "i18n": {"default": "Legacy line 2", "zh": "旧版第 2 行", "zh-TW": "舊版第 2 行"}},
      "line3": {"type": "string", "title": "Legacy line 3", "maxLength": 64, "readOnly": true, "i18n": {"default": "Legacy line 3", "zh": "旧版第 3 行", "zh-TW": "舊版第 3 行"}},
      "line4": {"type": "string", "title": "Legacy line 4", "maxLength": 64, "readOnly": true, "i18n": {"default": "Legacy line 4", "zh": "旧版第 4 行", "zh-TW": "舊版第 4 行"}}
    }
  },
  "secret_fields": [],
  "memory_budget": "2M",
  "resource_limits": {"memory_max": "32M", "cpu_quota": "80%", "tasks_max": 8, "limit_nofile": 32},
  "healthcheck": {
    "type": "exec",
    "command": ["bin/onekvm-nanokvm-oled", "--health"],
    "timeout_seconds": 8
  }
}
